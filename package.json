{
  "name": "appium-mobile-e2e-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform (Android + iOS) mobile E2E suite with Appium, WebdriverIO and TypeScript against Sauce Labs My Demo App.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@wdio/appium-service": "^10.0.0",
    "@wdio/cli": "^10.0.0",
    "@wdio/globals": "^10.0.0",
    "@wdio/junit-reporter": "^10.0.0",
    "@wdio/local-runner": "^10.0.0",
    "@wdio/mocha-framework": "^10.0.0",
    "@wdio/spec-reporter": "^10.0.0",
    "appium": "^3.8.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "scripts": {
    "test:android": "wdio run config/wdio.android.conf.ts",
    "test:ios": "wdio run config/wdio.ios.conf.ts",
    "smoke:android": "TAG=@smoke wdio run config/wdio.android.conf.ts",
    "app:android": "tsx scripts/download-app.ts android",
    "app:ios": "tsx scripts/download-app.ts ios",
    "drivers": "appium driver install uiautomator2 && appium driver install xcuitest",
    "doctor:android": "appium driver doctor uiautomator2",
    "doctor:ios": "appium driver doctor xcuitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "appium",
    "webdriverio",
    "typescript",
    "mobile-testing",
    "android",
    "ios",
    "e2e-testing",
    "test-automation",
    "sdet"
  ],
  "license": "MIT"
}
